# Chaîne de connexion Neon PostgreSQL (Pooled - pour l'application SvelteKit / Vercel Serverless)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Chaîne de connexion Neon PostgreSQL (Directe non pooled - pour les migrations Drizzle Kit)
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Secret de session pour l'espace administration
ADMIN_SECRET="ecofip-secret-key-change-in-production"
