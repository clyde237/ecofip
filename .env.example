# Chaîne de connexion Neon PostgreSQL (Pooled - pour l'application SvelteKit / Vercel Serverless)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Chaîne de connexion Neon PostgreSQL (Directe non pooled - pour les migrations Drizzle Kit)
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Identifiants de l'espace administration (à définir localement et sur Vercel)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="replace-with-a-unique-password"

# Clé HMAC de session: au moins 32 caractères aléatoires
ADMIN_SECRET="replace-with-at-least-32-random-characters"
