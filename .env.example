# Chaîne de connexion Neon PostgreSQL (Pooled - pour l'application SvelteKit / Vercel Serverless)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Chaîne de connexion Neon PostgreSQL (Directe non pooled - pour les migrations Drizzle Kit)
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Identifiants de l'espace administration (à définir localement et sur Vercel)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="replace-with-a-unique-password"

# Clé HMAC de session: au moins 32 caractères aléatoires
ADMIN_SECRET="replace-with-at-least-32-random-characters"

# Déconnexion automatique de l'espace admin (facultatif)
# Minutes d'inactivité avant déconnexion (défaut : 30)
ADMIN_SESSION_IDLE_MINUTES=30
# Durée maximale d'une session en heures, même active (défaut : 12)
ADMIN_SESSION_MAX_HOURS=12

# ==============================================================================
# Stockage de fichiers Cloudflare R2 (Compatible S3 - Vidéos & Médias)
# ==============================================================================
# Endpoint S3 de votre compte Cloudflare (ex: https://<account-id>.r2.cloudflarestorage.com)
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"

# Clés d'API S3 générées depuis Cloudflare R2 -> Manage R2 API Tokens
R2_ACCESS_KEY_ID="<votre-access-key-id>"
R2_SECRET_ACCESS_KEY="<votre-secret-access-key>"

# Nom du bucket créé sur Cloudflare R2
R2_BUCKET_NAME="ecofip-media"

# URL publique de diffusion (domaine public r2.dev ou domaine personnalisé configuré dans R2)
R2_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"

# Référencement : adresse publique du site (URL canoniques, sitemap, partages)
PUBLIC_SITE_URL=https://ecofip.vercel.app
# Code de vérification Google Search Console (balise meta « google-site-verification »)
PUBLIC_GOOGLE_SITE_VERIFICATION=
